# Copy this file to .env and fill in the values.

# --- Tech4Animals landmarks API (48 points, Martvel et al. 2024) ------------------
# Required for the analysis. For development: python -m tools.mock_landmarks_server --profile pain
# and then LANDMARKS_API_URL=http://127.0.0.1:6400/landmarks
LANDMARKS_API_URL=
LANDMARKS_API_TIMEOUT=30

# --- Azure OpenAI (report and chat) ------------------------------------------------
# Without these values the app works and shows an automatic summary instead of the report.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Optional ------------------------------------------------------------------------
YOLO_WEIGHTS=models/cat_face_yolov8n.pt
YOLO_MIN_CONF=0.35
THERMAL_BODY_OFFSET_C=7.8
PORT=5000
